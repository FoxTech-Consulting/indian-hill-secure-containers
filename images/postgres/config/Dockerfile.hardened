# Hardened remains a digest-bound additive child of Secure. It installs the
# restricted remote-access policy but no production key material.
ARG SECURE_BASE=ihl/postgres:16.15-secure-candidate.1
FROM ${SECURE_BASE}
ARG POSTGRES_VERSION=16.15
ARG POSTGRES_VERSION_LINE=16
ARG POSTGRES_ARTIFACT_ID=IHL-CTR-0004
ARG OCI_SOURCE="https://gitlab.com/indianhilllabs/indian-hill-secure-containers"
ARG OCI_REVISION="manual-build"
ARG OCI_CREATED="1970-01-01T00:00:00Z"
LABEL org.opencontainers.image.title="Indian Hill Hardened PostgreSQL ${POSTGRES_VERSION_LINE}" \
      org.opencontainers.image.description="CIS-aligned rootless PostgreSQL ${POSTGRES_VERSION_LINE} with tailored database configuration hardening" \
      org.opencontainers.image.version="${POSTGRES_VERSION}-hardened-candidate.1" \
      org.opencontainers.image.vendor="Indian Hill Labs" \
      org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      com.indianhilllabs.artifact.id="${POSTGRES_ARTIFACT_ID}" \
      com.indianhilllabs.assurance.level="hardened" \
      com.indianhilllabs.assurance.inherits="secure" \
      com.indianhilllabs.assurance.cis-profile="ihl-ubuntu2404-chiseled-cis-level1-tailored"
COPY --chown=1654:1654 images/postgres/config/postgresql.hardened.conf /opt/ihl/postgresql/postgresql.conf
COPY --chown=1654:1654 images/postgres/config/pg_hba.hardened.conf /opt/ihl/postgresql/pg_hba.hardened.conf
ENV IHL_ASSURANCE_LEVEL="hardened"
USER 1654:1654
WORKDIR /var/lib/postgresql/data
EXPOSE 5432
ENTRYPOINT ["/usr/local/bin/ihl-postgres-entrypoint"]
STOPSIGNAL SIGINT
