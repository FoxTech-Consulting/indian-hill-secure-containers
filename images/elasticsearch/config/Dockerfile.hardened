ARG SECURE_BASE
FROM ${SECURE_BASE} AS cis-policy-builder
USER 0
COPY --chown=0:0 --chmod=0500 images/elasticsearch/config/cis-policy-build.sh /tmp/ihl-cis-policy-build.sh
RUN /bin/sh /tmp/ihl-cis-policy-build.sh

FROM ${SECURE_BASE}
ARG ELASTICSEARCH_VERSION=9.5.5
ARG ELASTICSEARCH_VERSION_LINE=9.5
ARG ELASTICSEARCH_ARTIFACT_ID=IHL-CTR-0009
LABEL org.opencontainers.image.title="Indian Hill Elasticsearch ${ELASTICSEARCH_VERSION_LINE} Platform" \
      org.opencontainers.image.version="${ELASTICSEARCH_VERSION}" \
      com.indianhilllabs.artifact.id="${ELASTICSEARCH_ARTIFACT_ID}" \
      com.indianhilllabs.assurance.level="hardened" \
      com.indianhilllabs.assurance.inherits="secure"
COPY --chown=1000:0 --chmod=0660 images/elasticsearch/config/elasticsearch.hardened.yml /usr/share/elasticsearch/config/elasticsearch.yml
COPY --chown=1000:0 --chmod=0440 images/elasticsearch/config/hardening.options /usr/share/elasticsearch/config/jvm.options.d/ihl-hardening.options
COPY --from=cis-policy-builder /ihl-cis-policy-files/ /
USER 0
COPY --chown=0:0 --chmod=0500 images/elasticsearch/config/cis-hardening.sh /tmp/ihl-cis-hardening.sh
RUN /bin/sh /tmp/ihl-cis-hardening.sh && rm /tmp/ihl-cis-hardening.sh
ENV IHL_ASSURANCE_LEVEL="hardened"
USER 1000:0
