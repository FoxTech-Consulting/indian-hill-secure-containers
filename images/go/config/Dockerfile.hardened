ARG SECURE_BASE
# Directory-only stages normalize inherited mode bits without adding a tool,
# application, or replacement identity/trust data to the delivered image.
FROM scratch AS root-directory-metadata
WORKDIR /etc/ssl/certs

FROM scratch AS app-directory-metadata
USER 1654:1654
WORKDIR /app

FROM ${SECURE_BASE}
COPY --from=root-directory-metadata --chown=0:0 --chmod=0755 / /
COPY --from=app-directory-metadata --chown=1654:1654 --chmod=0755 / /
ARG OCI_REVISION
ARG OCI_CREATED
LABEL org.opencontainers.image.title="Indian Hill Hardened Go Static Runtime Base" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      com.indianhilllabs.assurance.level="hardened" \
      com.indianhilllabs.assurance.inherits="secure" \
      com.indianhilllabs.assurance.cis-profile="ihl-go-portable-image-cis"
ENV IHL_ASSURANCE_LEVEL="hardened" GOMEMLIMIT="192MiB" GOTRACEBACK="none"
USER 1654:1654
WORKDIR /app
