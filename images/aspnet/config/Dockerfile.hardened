# The Hardened runtime is an additive layer over the exact Secure runtime
# produced and digest-bound in the same pipeline.
ARG SECURE_BASE=ihl/aspnet-runtime:10.0.13-secure-lab.1
FROM ${SECURE_BASE}

ARG ASPNET_VERSION=10.0.13
ARG ASPNET_VERSION_LINE=10
ARG ASPNET_ARTIFACT_ID=IHL-CTR-0001

ARG OCI_SOURCE="https://gitlab.com/indianhilllabs/indian-hill-secure-containers"
ARG OCI_REVISION="manual-build"
ARG OCI_CREATED="1970-01-01T00:00:00Z"

LABEL org.opencontainers.image.title="Indian Hill Hardened ASP.NET ${ASPNET_VERSION_LINE} Runtime" \
      org.opencontainers.image.description="CIS-aligned Hardened ASP.NET ${ASPNET_VERSION_LINE} runtime with .NET diagnostic surfaces disabled" \
      org.opencontainers.image.version="${ASPNET_VERSION}-hardened-lab.1" \
      org.opencontainers.image.vendor="Indian Hill Labs" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      com.indianhilllabs.artifact.id="${ASPNET_ARTIFACT_ID}" \
      com.indianhilllabs.standard="IHL-SCS-001-v0.1-draft" \
      com.indianhilllabs.assurance.level="hardened" \
      com.indianhilllabs.assurance.inherits="secure" \
      com.indianhilllabs.assurance.cis-profile="ihl-ubuntu2404-chiseled-cis-level1-tailored"

# DOTNET_EnableDiagnostics=0 is the controlling .NET switch. The narrower
# switches make the intended debugger, profiler, IPC, EventPipe, and perf-map
# posture explicit for inspection and fail closed if future runtime behavior
# becomes more granular.
ENV IHL_ASSURANCE_LEVEL="hardened" \
    DOTNET_EnableDiagnostics="0" \
    DOTNET_EnableDiagnostics_IPC="0" \
    DOTNET_EnableDiagnostics_Debugger="0" \
    DOTNET_EnableDiagnostics_Profiler="0" \
    DOTNET_ENABLE_PROFILING="0" \
    DOTNET_EnableEventPipe="0" \
    DOTNET_PerfMapEnabled="0"

# Repeat the inherited runtime contract so the Hardened source is reviewable
# without relying on implicit parent metadata.
USER 1654:1654
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/usr/bin/dotnet"]
CMD ["--info"]
STOPSIGNAL SIGTERM
