ARG SECURE_BASE
FROM ${SECURE_BASE}
ARG OCI_REVISION="manual-build"
LABEL com.indianhilllabs.assurance.level="hardened" org.opencontainers.image.revision="${OCI_REVISION}"
ENV IHL_ASSURANCE_LEVEL="hardened" JAVA_TOOL_OPTIONS="-XX:+DisableAttachMechanism -XX:-UsePerfData -XX:+ExitOnOutOfMemoryError -XX:MaxRAMPercentage=60.0 -Djava.awt.headless=true"
USER 1654:1654
WORKDIR /app
ENTRYPOINT ["/opt/java/bin/java"]
CMD ["-version"]
