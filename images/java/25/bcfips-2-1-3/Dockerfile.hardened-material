ARG HARDENED_BASE
FROM docker.io/library/gcc:11.2.0@sha256:2c5cae6b84598eb6865d6c7b340deef80e8834a4c4037a5cbba755a5258809d4 AS compile
ADD --checksum=sha256:ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94 https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz /tmp/jdk.tar.gz
RUN mkdir /opt/jdk && tar -xzf /tmp/jdk.tar.gz --strip-components=1 -C /opt/jdk
ADD --checksum=sha256:f55fc476ede820d5c03fe87e6ced5bb0095e1dc30b387445846a3ff0274f8c0e https://repo.maven.apache.org/maven2/org/bouncycastle/bc-fips/2.1.3/bc-fips-2.1.3.jar /tmp/bc-fips.jar
# The public trust anchors are converted, never private application keys.
RUN /opt/jdk/bin/keytool -importkeystore -noprompt -srckeystore /opt/jdk/lib/security/cacerts -srcstoretype PKCS12 -srcstorepass changeit -destkeystore /tmp/cacerts.bcfks -deststoretype BCFKS -deststorepass changeit -providerclass org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider -providerpath /tmp/bc-fips.jar -J-Dorg.bouncycastle.fips.approved_only=true -J-Dorg.bouncycastle.native.cpu_variant=java
COPY images/java/config/fips/OsEntropyProvider.java /tmp/OsEntropyProvider.java
COPY images/java/config/fips/entropy.mf /tmp/entropy.mf
RUN mkdir /entropy && /opt/jdk/bin/javac --release 8 -d /entropy /tmp/OsEntropyProvider.java && /opt/jdk/bin/jar --create --file /tmp/ihl-entropy.jar --manifest /tmp/entropy.mf --date=2026-01-01T00:00:00Z -C /entropy .
RUN echo 'b02880ad826939b1268f491eb4877ef34eb54bc0f92b9708878d88770f3fab60  /tmp/ihl-entropy.jar' | sha256sum -c -
FROM ${HARDENED_BASE}
ARG OCI_REVISION="manual-build"
ADD --checksum=sha256:f55fc476ede820d5c03fe87e6ced5bb0095e1dc30b387445846a3ff0274f8c0e --chmod=0444 https://repo.maven.apache.org/maven2/org/bouncycastle/bc-fips/2.1.3/bc-fips-2.1.3.jar /opt/java/lib/bc-fips.jar
ADD --checksum=sha256:a30e550f06dcfa0fd7da1e9a501f111421406fa237467522b3ca05187429832d --chmod=0444 https://repo.maven.apache.org/maven2/org/bouncycastle/bcutil-fips/2.1.7/bcutil-fips-2.1.7.jar /opt/java/lib/bcutil-fips.jar
ADD --checksum=sha256:d2233207daecc2dfccdc317a53bd874b12c21a6dc5be78e390d8826eb726194c --chmod=0444 https://repo.maven.apache.org/maven2/org/bouncycastle/bctls-fips/2.1.24/bctls-fips-2.1.24.jar /opt/java/lib/bctls-fips.jar
COPY --chmod=0444 images/java/25/java.security /opt/java/conf/security/java.security
COPY --from=compile --chmod=0444 /tmp/ihl-entropy.jar /opt/java/lib/ihl-entropy.jar
COPY --from=compile --chmod=0444 /tmp/cacerts.bcfks /opt/java/lib/security/cacerts
LABEL com.indianhilllabs.assurance.level="validated" com.indianhilllabs.crypto.module="BC-FJA" com.indianhilllabs.crypto.version="2.1.3" com.indianhilllabs.crypto.certification="pending" org.opencontainers.image.revision="${OCI_REVISION}"
ENV IHL_ASSURANCE_LEVEL="validated" IHL_JAVA_FIPS="required" IHL_BC_CERTIFICATION="pending" JAVA_TOOL_OPTIONS="-XX:+DisableAttachMechanism -XX:-UsePerfData -XX:+ExitOnOutOfMemoryError -XX:MaxRAMPercentage=60.0 -Djava.awt.headless=true -Dorg.bouncycastle.fips.approved_only=true -Dorg.bouncycastle.native.cpu_variant=java -Xbootclasspath/a:/opt/java/lib/bc-fips.jar:/opt/java/lib/bcutil-fips.jar:/opt/java/lib/bctls-fips.jar:/opt/java/lib/ihl-entropy.jar -Djavax.net.ssl.trustStoreType=BCFKS -Djavax.net.ssl.trustStorePassword=changeit -Djdk.tls.client.protocols=TLSv1.3,TLSv1.2 -Djdk.tls.server.protocols=TLSv1.3,TLSv1.2"
USER 1654:1654
WORKDIR /app
ENTRYPOINT ["/opt/java/bin/java"]
CMD ["-version"]
