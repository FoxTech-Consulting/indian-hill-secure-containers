# The FIPS Provider source and builder are pinned to the tested configuration
# identified by CMVP certificate 4985. The provider, not CPython or this
# container, is the validated cryptographic module.
ARG FIPS_BUILDER=docker.io/library/gcc:11.2.0@sha256:2c5cae6b84598eb6865d6c7b340deef80e8834a4c4037a5cbba755a5258809d4
ARG HARDENED_BASE=ihl/python:3.13.18-hardened-lab.1

FROM ${FIPS_BUILDER} AS openssl-fips-module-build

ARG OPENSSL_VERSION=3.1.2
ARG OPENSSL_SOURCE_SHA256=a0ce69b8b97ea6a35b96875235aa453b966ba3cba8af2de23657d8b6767d6539

ADD --checksum=sha256:a0ce69b8b97ea6a35b96875235aa453b966ba3cba8af2de23657d8b6767d6539 \
    https://www.openssl.org/source/openssl-3.1.2.tar.gz \
    /tmp/openssl-3.1.2.tar.gz

RUN set -eu; \
    run_logged() { \
      log="$1"; shift; \
      if ! "$@" >"$log" 2>&1; then \
        printf 'ERROR: OpenSSL FIPS build command failed: %s\n' "$*" >&2; \
        tail -n 250 "$log" >&2; \
        exit 1; \
      fi; \
    }; \
    printf '%s  %s\n' "$OPENSSL_SOURCE_SHA256" /tmp/openssl-3.1.2.tar.gz | sha256sum --check --strict; \
    tar --extract --gzip --file /tmp/openssl-3.1.2.tar.gz --directory /tmp; \
    cd "/tmp/openssl-$OPENSSL_VERSION"; \
    run_logged /tmp/openssl-fips-configure.log ./Configure enable-fips --prefix=/opt/openssl --openssldir=/opt/openssl/ssl --libdir=lib; \
    run_logged /tmp/openssl-fips-build.log make -j2; \
    run_logged /tmp/openssl-fips-install.log make install; \
    install -d -m 0755 /opt/openssl/share/licenses/openssl; \
    install -m 0644 LICENSE.txt /opt/openssl/share/licenses/openssl/LICENSE.txt

FROM ${FIPS_BUILDER} AS openssl-supported-base-build

# Selected Hardened retains this material without running FIPS qualification probes.
ARG IHL_FIPS_BUILD_VALIDATION=true

ARG OPENSSL_BASE_VERSION=3.5.9
ARG OPENSSL_BASE_SOURCE_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

ADD --checksum=sha256:603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a \
    https://www.openssl.org/source/openssl-3.5.9.tar.gz \
    /tmp/openssl-3.5.9.tar.gz

RUN set -eu; \
    run_logged() { \
      log="$1"; shift; \
      if ! "$@" >"$log" 2>&1; then \
        printf 'ERROR: supported OpenSSL build command failed: %s\n' "$*" >&2; \
        tail -n 250 "$log" >&2; \
        exit 1; \
      fi; \
    }; \
    printf '%s  %s\n' "$OPENSSL_BASE_SOURCE_SHA256" /tmp/openssl-3.5.9.tar.gz | sha256sum --check --strict; \
    tar --extract --gzip --file /tmp/openssl-3.5.9.tar.gz --directory /tmp; \
    cd "/tmp/openssl-$OPENSSL_BASE_VERSION"; \
    run_logged /tmp/openssl-base-configure.log ./Configure no-fips --prefix=/opt/openssl --openssldir=/opt/openssl/ssl --libdir=lib; \
    run_logged /tmp/openssl-base-build.log make -j2; \
    run_logged /tmp/openssl-base-install.log make install_sw install_ssldirs; \
    install -d -m 0755 /opt/openssl/share/licenses/openssl; \
    install -m 0644 LICENSE.txt /opt/openssl/share/licenses/openssl/LICENSE.txt

COPY --from=openssl-fips-module-build /opt/openssl/lib/ossl-modules/fips.so /opt/openssl/lib/ossl-modules/fips.so
COPY images/python/config/fips/openssl-fips.cnf /opt/openssl/ssl/openssl-fips.cnf

RUN set -eu; \
    export LD_LIBRARY_PATH=/opt/openssl/lib; \
    export OPENSSL_MODULES=/opt/openssl/lib/ossl-modules; \
    /opt/openssl/bin/openssl fipsinstall \
      -module /opt/openssl/lib/ossl-modules/fips.so \
      -out /opt/openssl/ssl/fipsmodule.cnf \
      -provider_name fips \
      -section_name fips_sect \
      -pedantic \
      -self_test_onload; \
    ! grep -Eq '^(install-status|install-mac)[[:space:]]*=' /opt/openssl/ssl/fipsmodule.cnf; \
    export OPENSSL_CONF=/opt/openssl/ssl/openssl-fips.cnf; \
    case "$IHL_FIPS_BUILD_VALIDATION" in true|false) ;; *) \
      echo 'ERROR: IHL_FIPS_BUILD_VALIDATION must be true or false.' >&2; exit 1 ;; esac; \
    if [ "$IHL_FIPS_BUILD_VALIDATION" = true ]; then \
      /opt/openssl/bin/openssl fipsinstall -config "$OPENSSL_CONF"; \
      /opt/openssl/bin/openssl list -providers -verbose | grep -F 'OpenSSL FIPS Provider'; \
      if printf 'prohibited algorithm probe\n' | /opt/openssl/bin/openssl dgst -md5 >/dev/null 2>&1; then \
        echo 'ERROR: MD5 resolved while fips=yes was enforced.' >&2; \
        exit 1; \
      fi; \
    fi; \
    install -d -m 0755 /opt/openssl/share/indianhilllabs; \
    { \
      printf 'fipsBuildValidation=%s\n' "$IHL_FIPS_BUILD_VALIDATION"; \
      printf 'moduleSourceVersion=3.1.2\n'; \
      printf 'moduleSourceArchiveSha256=a0ce69b8b97ea6a35b96875235aa453b966ba3cba8af2de23657d8b6767d6539\n'; \
      printf 'baseLibrarySourceVersion=3.5.9\n'; \
      printf 'baseLibrarySourceArchiveSha256=%s\n' "$OPENSSL_BASE_SOURCE_SHA256"; \
      /opt/openssl/bin/openssl version -a; \
      sha256sum /opt/openssl/lib/ossl-modules/fips.so; \
      sha256sum /opt/openssl/ssl/fipsmodule.cnf; \
      sha256sum /opt/openssl/ssl/openssl-fips.cnf; \
    } > /opt/openssl/share/indianhilllabs/fips-build-info.txt

# Test the exact CPython runtime bits inherited from Hardened while the FIPS
# provider and supported base library are configured. The final layer copies
# only this cryptographic boundary into that runtime. Explicit Validated builds
# verify it; selected Hardened skips qualification probes.
FROM ${HARDENED_BASE} AS python-fips-runtime-validation

ARG IHL_FIPS_BUILD_VALIDATION=true

# Run with the actual inherited interpreter, loader, libc, and extension
# dependencies, not the older FIPS compiler's userspace. This disposable stage
# writes evidence only; the final image stays non-root and gains no build tools.
USER 0:0
COPY --from=openssl-supported-base-build /opt/openssl /opt/openssl
COPY images/python/config/fips/validate_runtime.py /tmp/ihl-validate-python-fips.py

ENV LD_LIBRARY_PATH="/opt/openssl/lib" \
    OPENSSL_CONF="/opt/openssl/ssl/openssl-fips.cnf" \
    OPENSSL_MODULES="/opt/openssl/lib/ossl-modules"
RUN ["/opt/python/bin/python3", "-I", "/tmp/ihl-validate-python-fips.py"]

FROM ${HARDENED_BASE}

ARG OCI_SOURCE="https://gitlab.com/indianhilllabs/indian-hill-secure-containers"
ARG OCI_REVISION="manual-build"
ARG OCI_CREATED="1970-01-01T00:00:00Z"

ARG PYTHON_VERSION=3.13.18
ARG PYTHON_VERSION_LINE=3.13
ARG PYTHON_ARTIFACT_ID=IHL-CTR-0003

LABEL org.opencontainers.image.title="Indian Hill Validated Python ${PYTHON_VERSION_LINE} Runtime" \
      org.opencontainers.image.description="Hardened CPython linked to the OpenSSL FIPS Provider 3.1.2 and supported OpenSSL 3.5.9 LTS base library" \
      org.opencontainers.image.version="${PYTHON_VERSION}-validated-lab.1" \
      org.opencontainers.image.vendor="Indian Hill Labs" \
      org.opencontainers.image.licenses="PSF-2.0 AND Apache-2.0" \
      org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      com.indianhilllabs.artifact.id="${PYTHON_ARTIFACT_ID}" \
      com.indianhilllabs.standard="IHL-SCS-001-v0.1-draft" \
      com.indianhilllabs.assurance.level="validated" \
      com.indianhilllabs.assurance.inherits="hardened" \
      com.indianhilllabs.assurance.cis-profile="ihl-ubuntu2404-chiseled-cis-level1-tailored" \
      com.indianhilllabs.assurance.stig-profile="ihl-ubuntu2404-chiseled-stig-tailored" \
      com.indianhilllabs.crypto.standard="FIPS 140-3" \
      com.indianhilllabs.crypto.module="OpenSSL FIPS Provider 3.1.2" \
      com.indianhilllabs.crypto.cmvp-certificate="4985" \
      com.indianhilllabs.crypto.base-library="OpenSSL 3.5.9"

COPY --from=openssl-supported-base-build /opt/openssl/lib/libcrypto.so.3 /opt/openssl/lib/libcrypto.so.3
COPY --from=openssl-supported-base-build /opt/openssl/lib/libssl.so.3 /opt/openssl/lib/libssl.so.3
COPY --from=openssl-supported-base-build /opt/openssl/lib/ossl-modules/fips.so /opt/openssl/lib/ossl-modules/fips.so
COPY --from=openssl-supported-base-build /opt/openssl/ssl/fipsmodule.cnf /opt/openssl/ssl/fipsmodule.cnf
COPY --from=openssl-supported-base-build /opt/openssl/ssl/openssl-fips.cnf /opt/openssl/ssl/openssl-fips.cnf
COPY --from=python-fips-runtime-validation /opt/openssl/share/indianhilllabs/fips-build-info.txt /opt/openssl/share/indianhilllabs/fips-build-info.txt
COPY --from=openssl-supported-base-build /opt/openssl/share/licenses/openssl/LICENSE.txt /opt/openssl/share/licenses/openssl/LICENSE.txt

ENV IHL_ASSURANCE_LEVEL="validated" \
    IHL_FIPS_STANDARD="FIPS 140-3" \
    IHL_FIPS_MODULE_NAME="OpenSSL FIPS Provider" \
    IHL_FIPS_MODULE_VERSION="3.1.2" \
    IHL_FIPS_CMVP_CERTIFICATE="4985" \
    IHL_FIPS_SOURCE_SHA256="a0ce69b8b97ea6a35b96875235aa453b966ba3cba8af2de23657d8b6767d6539" \
    IHL_OPENSSL_BASE_NAME="OpenSSL" \
    IHL_OPENSSL_BASE_VERSION="3.5.9" \
    IHL_OPENSSL_BASE_SOURCE_SHA256="603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a" \
    LD_LIBRARY_PATH="/opt/openssl/lib" \
    OPENSSL_CONF="/opt/openssl/ssl/openssl-fips.cnf" \
    OPENSSL_MODULES="/opt/openssl/lib/ossl-modules"

USER 1654:1654
WORKDIR /app
ENTRYPOINT ["/opt/python/bin/python3"]
CMD ["--version"]
