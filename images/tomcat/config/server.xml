<?xml version="1.0" encoding="UTF-8"?>
<Server port="-1">
  <Service name="Catalina">
    <Connector port="8080" protocol="org.apache.coyote.http11.Http11NioProtocol"
      connectionTimeout="20000" maxThreads="100" maxConnections="1024"
      acceptCount="100" maxHttpRequestHeaderSize="8192" maxParameterCount="1000"
      maxPostSize="2097152" maxSavePostSize="4096" allowTrace="false"
      xpoweredBy="false" serverRemoveAppProvidedValues="true" />
    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps" unpackWARs="false" autoDeploy="false"
        deployOnStartup="true" deployXML="false">
        <Valve className="org.apache.catalina.valves.ErrorReportValve"
          showReport="false" showServerInfo="false" />
        <Valve className="org.apache.catalina.valves.AccessLogValve"
          directory="/dev" prefix="stdout" suffix="" rotatable="false"
          buffered="false" pattern="%a %t &quot;%m %U %H&quot; %s %b %D" />
      </Host>
    </Engine>
  </Service>
</Server>
